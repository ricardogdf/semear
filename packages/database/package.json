{
  "name": "@semear/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema ./prisma/schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema ./prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@semear/utils": "*"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.6.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}

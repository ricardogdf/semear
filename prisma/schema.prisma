generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubjectStatus {
  IN_PROGRESS
  APPROVED
  FAILED
}

enum ContentSource {
  TXT
  PDF
}

enum UserRole {
  USER
  ADMIN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
}

/// Estado do processamento por IA de uma aula.
enum ContentProcessingStatus {
  /// Texto salvo; processamento por IA em andamento.
  PROCESSING
  /// Conteúdo didático identificado e material gerado.
  COMPLETED
  /// Aula introdutória/administrativa: processada, sem geração de questões.
  NO_QUESTIONS_NEEDED
  /// Conteúdo insuficiente ou ambíguo: revisão humana recomendada.
  NEEDS_REVIEW
  /// Falha técnica (provedor, credencial, resposta inválida). Pode ser reprocessada.
  FAILED
}

enum ContentClassification {
  SUBSTANTIVE
  INTRODUCTORY
  ADMINISTRATIVE
  INSUFFICIENT
}

/// Quem vê uma matéria ou publicação: só o dono (PRIVATE) ou qualquer pessoa com o link (PUBLIC).
enum Visibility {
  PRIVATE
  PUBLIC
}

enum PublicationType {
  ARTICLE
  TCC
  THESIS
  OTHER
}

enum ProcessingRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  /// Foto de perfil (URL https informada pelo próprio usuário).
  avatarUrl              String?
  /// Nome exibido no perfil público (se vazio, usa `name`).
  displayName            String?
  bio                    String?
  institution            String?
  course                 String?
  role                   UserRole               @default(USER)
  isActive               Boolean                @default(true)
  /// Hash scrypt da senha. Nulo até o usuário concluir o primeiro acesso.
  passwordHash           String?
  passwordUpdatedAt      DateTime?
  lastLoginAt            DateTime?
  defaultAiProvider      AiProvider?
  createdById            String?
  createdBy              User?                  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers           User[]                 @relation("UserCreatedBy")
  sessions               Session[]
  passwordSetupTokens    PasswordSetupToken[]   @relation("SetupTokenOwner")
  issuedSetupTokens      PasswordSetupToken[]   @relation("SetupTokenIssuer")
  reviewedAccessRequests AccessRequest[]        @relation("AccessRequestReviewer")
  createdFromRequests    AccessRequest[]        @relation("AccessRequestCreatedUser")
  aiCredentials          AiCredential[]
  processingRuns         ContentProcessingRun[]
  courses                Course[]
  subjects               Subject[]
  simulationResults      SimulationResult[]
  /// Matérias de outros usuários importadas a partir de matérias deste usuário (autoria preservada).
  importedSubjects       Subject[]              @relation("SubjectImportedFromOwner")
  followers              Follow[]               @relation("FollowFollowing")
  following              Follow[]               @relation("FollowFollower")
  publications           Publication[]
  publicationLikes       PublicationLike[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

/// Sessão de login. O cookie guarda o token opaco; o banco guarda apenas o SHA-256.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Código de uso único para o usuário definir a própria senha (primeiro acesso ou redefinição).
model PasswordSetupToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation("SetupTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("SetupTokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model AccessRequest {
  id            String              @id @default(cuid())
  name          String
  email         String
  message       String?
  status        AccessRequestStatus @default(PENDING)
  ipAddress     String?
  reviewedById  String?
  reviewedBy    User?               @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
  createdUserId String?
  createdUser   User?               @relation("AccessRequestCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// Eventos para limitação de taxa (login, solicitações de acesso, uploads).
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Credencial de API de um provedor de IA, criptografada com AES-256-GCM.
model AiCredential {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AiProvider
  encryptedKey    String
  iv              String
  authTag         String
  keyVersion      Int        @default(1)
  /// Últimos 4 caracteres, apenas para identificação visual.
  keyHint         String
  defaultModel    String?
  /// Modelos compatíveis retornados pelo provedor na última validação.
  availableModels Json       @default("[]")
  lastValidatedAt DateTime?
  lastErrorCode   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([userId, provider])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subject {
  id                     String             @id @default(cuid())
  title                  String
  instructor             String
  workloadHours          Int
  status                 SubjectStatus
  progress               Int
  difficulty             Int
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Apresentação da matéria na biblioteca pública.
  description            String             @default("")
  visibility             Visibility         @default(PRIVATE)
  /// Quando a matéria foi tornada pública pela última vez (null enquanto privada).
  publishedAt            DateTime?
  /// Cópia importada da matéria pública de outro usuário. Fica true mesmo se o original for excluído
  /// e, por CHECK no banco, a cópia nunca pode ser pública.
  isImported             Boolean            @default(false)
  /// Original da cópia (null se o original foi excluído). Cada linha com este campo é uma importação ativa.
  importedFromId         String?
  importedFrom           Subject?           @relation("SubjectImports", fields: [importedFromId], references: [id], onDelete: SetNull)
  imports                Subject[]          @relation("SubjectImports")
  importedFromOwnerId    String?
  importedFromOwner      User?              @relation("SubjectImportedFromOwner", fields: [importedFromOwnerId], references: [id], onDelete: SetNull)
  /// Título e autor do original no momento da importação (autoria preservada mesmo sem o original).
  importedFromTitle      String?
  importedFromAuthorName String?
  importedAt             DateTime?
  modules                SubjectModule[]
  contents               Content[]
  simulations            Simulation[]
  results                SimulationResult[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([userId, title])
  /// Uma importação ativa por usuário por original (também sob requisições simultâneas).
  @@unique([userId, importedFromId])
  @@index([importedFromId])
  @@index([visibility, publishedAt])
}

/// Módulo de uma matéria (ex.: Multiplicação em Matemática): agrupa aulas e permite simulados só dele.
model SubjectModule {
  id          String       @id @default(cuid())
  title       String
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  contents    Content[]
  simulations Simulation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([subjectId, title])
}

model Content {
  id                   String                  @id @default(cuid())
  title                String
  originalFileName     String
  source               ContentSource
  body                 String
  shortSummary         String                  @default("")
  summary              String                  @default("")
  importantTopics      String                  @default("")
  trainingQuestions    Json                    @default("[]")
  processingStatus     ContentProcessingStatus @default(COMPLETED)
  classification       ContentClassification?
  classificationReason String?
  /// Trechos didáticos (verificados no texto original) usados na geração de questões.
  relevantExcerpts     Json                    @default("[]")
  aiProvider           AiProvider?
  aiModel              String?
  inputTruncated       Boolean                 @default(false)
  processedAt          DateTime?
  errorCode            String?
  errorMessage         String?
  subjectId            String
  subject              Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Módulo da mesma matéria (opcional). Excluir o módulo mantém a aula na matéria, sem módulo.
  moduleId             String?
  module               SubjectModule?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  processingRuns       ContentProcessingRun[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([subjectId])
  @@index([moduleId])
}

/// Histórico de cada execução de processamento (provedor, modelo, resultado).
model ContentProcessingRun {
  id                 String                 @id @default(cuid())
  contentId          String
  content            Content                @relation(fields: [contentId], references: [id], onDelete: Cascade)
  userId             String
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           AiProvider
  model              String
  status             ProcessingRunStatus    @default(RUNNING)
  classification     ContentClassification?
  reason             String?
  questionsGenerated Int                    @default(0)
  errorCode          String?
  errorMessage       String?
  startedAt          DateTime               @default(now())
  finishedAt         DateTime?

  @@index([contentId, startedAt])
  @@index([userId, startedAt])
}

model Simulation {
  id               String             @id @default(cuid())
  title            String
  timeLimitMinutes Int
  /// Questões sorteadas com o gabarito e a aula de origem (contentId). Nunca enviadas ao navegador.
  questions        Json
  maxScore         Decimal            @db.Decimal(4, 2)
  subjectId        String
  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  /// Simulado só de um módulo. Nulo: matéria completa (ou módulo já excluído; ver moduleTitle).
  moduleId         String?
  module           SubjectModule?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// Nome do módulo na criação: identifica o simulado no histórico mesmo se o módulo for excluído.
  moduleTitle      String?
  results          SimulationResult[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([subjectId])
  @@index([moduleId])
}

model SimulationResult {
  id             String     @id @default(cuid())
  score          Decimal    @db.Decimal(4, 2)
  correctAnswers Int
  totalQuestions Int
  answers        Json
  /// Acertos por aula de origem ([{ contentId, correct, total }]): base do desempenho por módulo.
  contentStats   Json       @default("[]")
  submittedAt    DateTime   @default(now())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  simulationId   String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([subjectId, userId, simulationId])
}

/// Relação "seguidor segue usuário". A chave composta impede duplicatas; um CHECK impede seguir a si mesmo.
model Follow {
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
}

/// Artigo, TCC ou outra publicação acadêmica. Só pode ser visto, curtido e compartilhado (nunca importado).
model Publication {
  id          String            @id @default(cuid())
  type        PublicationType
  title       String
  /// Autor ou autores, como informados (coautores podem não ser usuários do Semear).
  authors     String
  abstract    String            @default("")
  institution String?
  publishedOn DateTime?         @db.Date
  /// Endereço no repositório de origem. O conteúdo externo nunca é copiado para o Semear.
  externalUrl String?
  visibility  Visibility        @default(PRIVATE)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       PublicationLike[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([visibility, createdAt])
}

/// Curtida: no máximo uma por usuário por publicação (chave composta).
model PublicationLike {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([userId, publicationId])
  @@index([publicationId])
}

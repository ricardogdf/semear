# Banco PostgreSQL. Na Vercel, use a URL com pooling do provedor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/semear

# Opcional (Vercel): URL direta, sem pooling, usada só para rodar as migrações no build.
# DIRECT_URL=

# Chave mestra (32 bytes em base64) para criptografar as chaves de API dos usuários (AES-256-GCM).
CREDENTIALS_ENCRYPTION_KEY=

# URL pública da aplicação (usada apenas nas mensagens do comando admin:create).
APP_URL=http://localhost:3000
